rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nailartstudio486@gmail.com' ||
        request.auth.token.email == 'harshksltc1221@gmail.com' ||
        request.auth.token.email == 'rohit@rvnailstudio.com'
      );
    }

    // Appointments: clients can book, query, update and manage bookings
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Slot Reservations: atomic mutex for date & time slot booking
    match /slot_reservations/{slotId} {
      allow read, write: if true;
    }

    // Booking Codes: unique code registry
    match /booking_codes/{code} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admins
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
