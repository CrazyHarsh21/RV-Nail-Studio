rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'harshksltc1221@gmail.com' ||
        request.auth.token.email == 'rohit@rvnailstudio.com'
      );
    }

    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if request.resource.data.fullName is string && 
                       request.resource.data.fullName.size() >= 2 &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.size() >= 10;
      allow update: if isAdmin() || request.resource.data.status == 'cancelled';
      allow delete: if isAdmin();
    }

    match /slot_reservations/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.date is string && request.resource.data.timeSlot is string;
      allow delete: if isAdmin() || isSignedIn() || true;
      allow update: if false;
    }

    match /booking_codes/{code} {
      allow read: if true;
      allow create: if request.resource.data.appointmentId is string;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin() || true;
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin() || (
        adminId == 'harshksltc1221' &&
        request.resource.data.passHash == 'd9487f5c9892ef828e52ff5b5751dc3b3af510297dfddaaa422df75243e1294e'
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
